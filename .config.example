# OpenWrt Configuration Example
# Copy to .config and modify as needed

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# Device selection (uncomment one)
# CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000=y
# CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# Kernel
CONFIG_KERNEL_BUILD_USER="github-actions"
CONFIG_KERNEL_BUILD_DOMAIN="actions.openwrt.org"

# Packages
CONFIG_ALL_NONSHARED=y
CONFIG_ALL_KMODS=y
CONFIG_ALL=y
CONFIG_AUTOREMOVE=y

# Signature verification
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y

# Additional packages (add as needed)
# CONFIG_PACKAGE_luci=y
# CONFIG_PACKAGE_luci-ssl=y
# CONFIG_PACKAGE_openssh-sftp-server=y
