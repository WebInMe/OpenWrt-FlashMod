+++ b/target/linux/mediatek/dts/mt7986a-xiaomi-redmi-router-ax6000-stock.dts
@@ -11,7 +11,8 @@
 &spi_nand_flash {
 	mediatek,nmbm;
 	mediatek,bmt-max-ratio = <1>;
-	mediatek,bmt-max-reserved-blocks = <64>;
+	/* must match the NMBM table written by the bootloader (128 blocks) */
+	mediatek,bmt-max-reserved-blocks = <128>;
 };
 
 &partitions {
@@ -34,6 +35,10 @@
 
+	/*
+	 * W25N02KV (256 MiB): NMBM reserves the last 128 blocks, so the
